{
  "name": "functions",
  "description": "Cloud Functions - notifications de suivi de commande (Blanchisserie)",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
